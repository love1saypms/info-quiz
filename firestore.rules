rules_version = '2';

// 이 앱은 Firestore를 앱 서버(서버용 비밀키)로만 읽고 씁니다.
// 서버용 비밀키는 아래 규칙과 상관없이 동작하므로, 브라우저에서 직접 읽고 쓰는 것은 모두 막습니다.
// - 학생: 공개 문제지 조회와 결과 제출은 앱 서버를 거칩니다. (정답·해설은 채점 뒤에만 받음)
// - 교사: 등록·공개 변경·결과 조회는 앱 서버가 허용된 교사 계정인지 확인한 뒤 처리합니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
